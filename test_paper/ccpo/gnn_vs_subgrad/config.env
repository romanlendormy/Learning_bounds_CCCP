# config.env — comparaison t* CCPO (borne GNN en un appel vs sous-gradient, à la racine). Sourcé par run_gnn.sh et
# run_subgrad_nodepack.sh, depuis la racine du dépôt. Réglages de la campagne (modèle ep57, ζ, OMP_WAIT_POLICY) repris de
# ../campaign_config.env ; surcharges possibles par l'environnement (sbatch --export=ALL,VAR=...).
TD=test_paper/ccpo
source $TD/campaign_config.env                 # MODEL, TORCH_THREADS, CCPO_ZETA_* (hybride SCIP, θ résiduel), OMP_WAIT_POLICY
BIN=build/solver_bab/bab_ccpo_rootcmp
INSTANCES_DIR=${INSTANCES_DIR:-$TD/instances}
OUT=${OUT_DIR:-${SCRATCH:-runs}/test_paper_ccpo_tstar}
T_MAX=${T_MAX:-1000}       # plafond d'itérations du sous-gradient (au-delà : t* censuré)
TIME_LIM=${TIME_LIM:-3600} # plafond de temps du sous-gradient par instance (s)
REPS=${REPS:-5}            # appels chronométrés (médiane) après un appel de pré-chauffage
