# campaign_config.env — réglages communs aux deux bras de la campagne CCPO de l'article :
# LD (MODE=gnn, λ prédit par le GNN) et LD0 (MODE=gnn_zero, λ = 0, même moteur). Sourcé par run_ld_array.sh.
MODEL=models/ccpo/ccpo_arm6_feas10k_200ep_ep57.scripted_batched.pt   # export TorchScript du modèle ep57 (md5 db805295…)
TL=0                  # aucune limite côté solveur ;
KILL_ABS=85800        # arrêt externe à 23 h 50 (statut KILLED_WALL), sous le mur SLURM de 24 h
T_ROOT=100; T_NODE=20 # itérations de sous-gradient (racine, nœud) : modes sld/ref seulement, sans effet pour gnn/gnn_zero
K=32                  # taille de bucket : nombre de nœuds évalués par forward GPU (multi-batching)
TORCH_THREADS=4
DEVICE=cuda
# ζ : évaluation OpenMP sur les scénarios (OMP_NUM_THREADS = cœurs alloués) ; hybride SCIP si n_free >= 11 (budget 20000 nœuds) ;
# pas d'héritage d'infaisabilité ; θ résiduel du nœud dans ζ (exact) ; attente OpenMP passive (stabilise les temps sur nœud GPU partagé).
export CCPO_ZETA_SCIP=1 CCPO_ZETA_SCIP_NF0=11 CCPO_ZETA_SCIP_NODES=20000 CCPO_ZETA_INHERIT=0 CCPO_ZETA_NODE_THETA=1
export OMP_WAIT_POLICY=passive
