import numpy as np
import os
import sys

# =============================================================================
# Générateur d'instances stochastiques — Chance-Constrained Multidimensional
# Knapsack (CCMK) à partir des fichiers OR-Library de Beasley.
#
# Fichiers supportés (même format) :
#   mknap1.txt, mknap2.txt,
#   mknapcb1.txt ... mknapcb9.txt
#
# Format OR-Library (mknap1 / mknapcb*) :
#   K                          <- nombre d'instances dans le fichier
#   n  m  opt                  <- variables, contraintes, valeur optimale
#   p(1) ... p(n)              <- profits
#   r(1,1) ... r(1,n)          <- poids contrainte 1
#   ...
#   r(m,1) ... r(m,n)          <- poids contrainte m
#   b(1) ... b(m)              <- capacités
#   [répété K fois]
#
# Perturbation stochastique (une instance de base -> N scénarios) :
#   A^i_{jk} = A_{jk} * (1 + sigma * eps^i_{jk}),  eps ~ N(0,1)
#   b^i_j    = b_j    * (1 + sigma * eta^i_j),      eta ~ N(0,1)
#   puis projection R+ : max(., 0)
#
# sigma ~ Uniform(sigma_range) tiré une seule fois par épisode.
#
# Format de sortie — une ligne par scénario :
#   [episode, scenario, nb_constraints, nb_items, sigma,
#    A^i_00, ..., A^i_{m-1,n-1},   (m*n valeurs, ligne=contrainte)
#    b^i_0,  ..., b^i_{m-1}]       (m valeurs)
# =============================================================================


# ---------------------------------------------------------------------------
# Lecture des fichiers OR-Library
# ---------------------------------------------------------------------------

def _tokens(filepath):
    """Générateur de tokens numériques depuis un fichier OR-Library."""
    with open(filepath, 'r') as f:
        for line in f:
            for tok in line.split():
                yield tok


def parse_orlib_file(filepath):
    """
    Parse un fichier OR-Library au format mknap1 / mknapcb*.

    Retourne une liste de dicts :
        {
          "name"       : str,         # nom dérivé du fichier + index
          "n"          : int,         # nombre de variables
          "m"          : int,         # nombre de contraintes
          "opt"        : float,       # valeur optimale (0 si inconnue)
          "profits"    : list[float], # longueur n
          "weights"    : list[list],  # shape (m, n)
          "capacities" : list[float], # longueur m
        }
    """
    basename = os.path.splitext(os.path.basename(filepath))[0]
    gen = _tokens(filepath)

    def next_int():   return int(next(gen))
    def next_float(): return float(next(gen))

    K = next_int()
    instances = []

    for k in range(K):
        n   = next_int()
        m   = next_int()
        opt = next_float()

        profits    = [next_float() for _ in range(n)]
        weights    = [[next_float() for _ in range(n)] for _ in range(m)]
        capacities = [next_float() for _ in range(m)]

        instances.append({
            "name"       : f"{basename}_{k+1}",
            "n"          : n,
            "m"          : m,
            "opt"        : opt,
            "profits"    : profits,
            "weights"    : weights,
            "capacities" : capacities,
        })

    print(f"  Fichier '{filepath}' : {K} instances lues "
          f"(n={instances[0]['n']}, m={instances[0]['m']})")
    return instances


# ---------------------------------------------------------------------------
# Génération des scénarios stochastiques
# ---------------------------------------------------------------------------

def perturb_scenario(A_base, b_base, sigma, rng):
    """
    Génère (A^i, b^i) par perturbation gaussienne de (A_base, b_base).

    A^i_{jk} = A_{jk} * (1 + sigma * eps),  eps ~ N(0,1)
    b^i_j    = b_j    * (1 + sigma * eta),   eta ~ N(0,1)
    Projection R+ : max(., 0)
    """
    m, n = A_base.shape
    A_i = A_base * (1.0 + sigma * rng.standard_normal((m, n)))
    b_i = b_base * (1.0 + sigma * rng.standard_normal(m))
    return np.maximum(A_i, 0.0), np.maximum(b_i, 0.0)


def generate_episode(episode_id, inst, nb_scenarios, sigma_range, rng):
    """
    Génère un épisode complet (nb_scenarios lignes).
    sigma est tiré une seule fois pour tout l'épisode.
    """
    A_base = np.array(inst["weights"],    dtype=float)  # (m, n)
    b_base = np.array(inst["capacities"], dtype=float)  # (m,)
    m, n   = inst["m"], inst["n"]

    sigma = rng.uniform(*sigma_range)

    lines = []
    for scen_id in range(nb_scenarios):
        A_i, b_i = perturb_scenario(A_base, b_base, sigma, rng)

        header = [episode_id, scen_id, m, n, round(sigma, 6)]
        A_flat = [round(v, 4) for v in A_i.flatten()]
        b_flat = [round(v, 4) for v in b_i]

        lines.append(header + A_flat + b_flat)

    return lines


# ---------------------------------------------------------------------------
# Écriture d'un dataset
# ---------------------------------------------------------------------------

def generate_dataset(filepath, inst, nb_episodes, nb_scenarios,
                     sigma_range=(0.05, 0.30), seed=None):
    """
    Génère un dataset pour une instance de base et l'écrit dans filepath.
    Tous les épisodes sont concaténés dans un seul fichier.

    Paramètres
    ----------
    filepath     : chemin de sortie
    inst         : dict instance OR-Library
    nb_episodes  : nombre d'épisodes (instances stochastiques)
    nb_scenarios : nombre de scénarios par épisode N
    sigma_range  : (sigma_min, sigma_max), sigma ~ Uniform
    seed         : graine numpy pour reproductibilité
    """
    rng = np.random.default_rng(seed)
    os.makedirs(os.path.dirname(filepath), exist_ok=True)

    total = 0
    with open(filepath, 'w') as f:
        for ep in range(nb_episodes):
            for line in generate_episode(ep, inst, nb_scenarios,
                                         sigma_range, rng):
                f.write(",".join(str(v) for v in line) + "\n")
                total += 1

    print(f"    -> {filepath}  "
          f"({nb_episodes} ep x {nb_scenarios} scén = {total} lignes)")


# ---------------------------------------------------------------------------
# Génération complète train / val / test
# ---------------------------------------------------------------------------

SPLITS = [
    # (split_name, nb_episodes, nb_scenarios, seed_offset)
    ("train", 200, 20, 0),
    ("val",    30, 20, 1),
    ("test",   50, 20, 2),
]

SEED_BASE   = 42
SIGMA_RANGE = (0.05, 0.30)


def generate_all(orlib_filepath, output_dir="data/knapsack/datasets",
                 instance_indices=None):
    """
    Point d'entrée principal.

    Paramètres
    ----------
    orlib_filepath   : chemin vers le fichier OR-Library téléchargé
                       (ex : "mknap1.txt", "mknapcb1.txt", ...)
    output_dir       : dossier racine de sortie.
                       Les fichiers sont écrits dans :
                         output_dir/train/ccmk-train-{name}.txt
                         output_dir/val/ccmk-val-{name}.txt
                         output_dir/test/ccmk-test-{name}.txt
    instance_indices : liste d'indices (0-based) des instances à utiliser.
                       None = toutes les instances du fichier.
    """
    print(f"\n=== Lecture de '{orlib_filepath}' ===")
    instances = parse_orlib_file(orlib_filepath)

    if instance_indices is not None:
        instances = [instances[i] for i in instance_indices]
        print(f"  Instances sélectionnées : {instance_indices}")

    print(f"\n=== Génération des datasets ({len(instances)} instances) ===\n")

    for split_name, nb_ep, nb_scen, seed_off in SPLITS:
        print(f"--- {split_name.upper()} ---")
        for inst in instances:
            generate_dataset(
                filepath=f"{output_dir}/{split_name}/ccmk-{split_name}-{inst['name']}.txt",
                inst=inst,
                nb_episodes=nb_ep,
                nb_scenarios=nb_scen,
                sigma_range=SIGMA_RANGE,
                seed=SEED_BASE + seed_off,
            )
        print()

    print("=== Terminé ===")
    print("\nFormat de chaque ligne :")
    print("  [episode, scenario, nb_constraints, nb_items, sigma,")
    print("   A^i_00, ..., A^i_{m-1,n-1},  (m*n valeurs)")
    print("   b^i_0,  ..., b^i_{m-1}]      (m valeurs)")
    print("\nNote : sigma identique pour tous les scénarios d'un épisode.")


# ---------------------------------------------------------------------------
# Utilisation en ligne de commande
#
#   python generate_ccmk_instances.py mknap1.txt
#   python generate_ccmk_instances.py mknapcb1.txt
#   python generate_ccmk_instances.py mknapcb1.txt 0 1 2   # instances 1,2,3
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage : python generate_ccmk_instances.py <orlib_file> "
              "[idx1 idx2 ...]")
        print("  ex  : python generate_ccmk_instances.py mknap1.txt")
        print("  ex  : python generate_ccmk_instances.py mknapcb1.txt 0 1 2")
        sys.exit(1)

    filepath = sys.argv[1]
    indices  = [int(i) for i in sys.argv[2:]] if len(sys.argv) > 2 else None

    generate_all(filepath, instance_indices=indices)