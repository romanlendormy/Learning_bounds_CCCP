import numpy as np
import os

# =============================================================================
# Générateur d'instances pour le problème de set covering chance-contraint
#
# Problème :
#   min  c^T x
#   s.t. A^i x >= b^i * z_i,  forall i in N
#        x in {0,1}^n,  z in Z
#
# Hypothèses (Proposition 5, Ahmed et al. 2016) :
#   - A^i in {0,1}^{m x n} - choisi selon une loi binomial(pA)
#   - b^i in {0,1}^m,  ||b^i||_inf = 1  (au moins une cible active) - choisi selon une loi binomial(pB)
#
# Application : déploiement de capteurs sous incertitude
#   - n sites potentiels pour placer des capteurs
#   - m cibles à surveiller
#   - A^i_kj = 1 si le capteur j peut détecter la cible k dans le scénario i
#   - b^i_k  = 1 si la cible k est active dans le scénario i
#
# Format de sortie (une ligne par scénario) :
#   [episode, scenario, nb_constraints, nb_items, pA, pB, A_ijk..., b_ik...]
#
# pA et pB sont tirés une seule fois par épisode (instance du problème),
# puis partagés par tous les scénarios de cet épisode.
# =============================================================================


def generate_scenario(m, n, pA, pB, rng):
    """
    Génère un scénario (A^i, b^i) pour une instance donnée.

    Paramètres
    ----------
    m   : int   — nombre de contraintes (cibles)
    n   : int   — nombre de variables (sites capteurs)
    pA  : float — probabilité qu'un capteur j détecte une cible k
    pB  : float — probabilité qu'une cible k soit active
    rng : np.random.Generator

    Retourne
    --------
    A : np.ndarray shape (m, n), dtype int  — matrice {0,1}
    b : np.ndarray shape (m,),   dtype int  — vecteur {0,1}, ||b||_inf = 1
    """
    # --- Génération de A^i ---
    A = rng.binomial(1, pA, size=(m, n))

    # Garantie de couverture minimale : chaque ligne a au moins un 1
    # (sinon la contrainte est infaisable pour b_k=1)
    for k in range(m):
        if A[k].sum() == 0:
            j_forced = rng.integers(0, n)
            A[k, j_forced] = 1

    # --- Génération de b^i ---
    b = rng.binomial(1, pB, size=(m,))

    # Garantie ||b^i||_inf = 1 : au moins une cible active
    if b.sum() == 0:
        k_forced = rng.integers(0, m)
        b[k_forced] = 1

    return A, b


def generate_episode(episode_id, nb_scenarios, nb_constraints, nb_items,
                     pA_range, pB_range, rng):
    """
    Génère un épisode complet (une instance du problème avec N scénarios).

    pA et pB sont tirés une seule fois pour tout l'épisode.

    Retourne une liste de lignes (une par scénario), chacune de la forme :
        [episode, scenario, nb_constraints, nb_items, pA, pB, A_flat..., b_flat...]
    """
    # pA et pB tirés une seule fois par épisode
    pA = rng.uniform(*pA_range)
    pB = rng.uniform(*pB_range)

    lines = []
    for scenario_id in range(nb_scenarios):
        A, b = generate_scenario(nb_constraints, nb_items, pA, pB, rng)

        header = [episode_id, scenario_id, nb_constraints, nb_items,
                  round(pA, 6), round(pB, 6)]
        A_flat = A.flatten().tolist()   # m*n valeurs, ligne par ligne
        b_flat = b.tolist()             # m valeurs

        line = header + A_flat + b_flat
        lines.append(line)

    return lines


def generate_dataset(filepath, nb_episodes, nb_scenarios,
                     nb_constraints, nb_items,
                     pA_range=(0.2, 0.5), pB_range=(0.3, 0.7),
                     seed=None):
    """
    Génère un dataset complet et l'écrit dans un unique fichier.
    Tous les épisodes sont concaténés : le fichier contient
    nb_episodes * nb_scenarios lignes au total.

    Paramètres
    ----------
    filepath       : chemin du fichier de sortie
    nb_episodes    : nombre d'instances (épisodes)
    nb_scenarios   : nombre de scénarios par épisode (N)
    nb_constraints : nombre de contraintes par scénario (m)
    nb_items       : nombre de variables de décision (n)
    pA_range       : intervalle pour pA ~ Uniform(pA_range[0], pA_range[1])
    pB_range       : intervalle pour pB ~ Uniform(pB_range[0], pB_range[1])
    seed           : graine aléatoire pour reproductibilité
    """
    rng = np.random.default_rng(seed)
    os.makedirs(os.path.dirname(filepath), exist_ok=True)

    total_lines = 0
    with open(filepath, 'w') as f:
        for ep in range(nb_episodes):
            lines = generate_episode(
                episode_id=ep,
                nb_scenarios=nb_scenarios,
                nb_constraints=nb_constraints,
                nb_items=nb_items,
                pA_range=pA_range,
                pB_range=pB_range,
                rng=rng
            )
            for line in lines:
                f.write(",".join(str(v) for v in line) + "\n")
            total_lines += len(lines)

    print(f"  -> {filepath}  "
          f"({nb_episodes} épisodes x {nb_scenarios} scénarios = {total_lines} lignes)")


# =============================================================================
# Configurations
#
# Structure des fichiers :
#   ccsp_data/
#     train/  ccsp-train-small.txt   (200 épisodes)
#             ccsp-train-medium.txt
#             ccsp-train-large.txt
#     val/    ccsp-val-small.txt     ( 30 épisodes)
#             ccsp-val-medium.txt
#             ccsp-val-large.txt
#     test/   ccsp-test-small.txt    ( 50 épisodes)
#             ccsp-test-medium.txt
#             ccsp-test-large.txt
#
# Variantes de taille :
#   - small  : m=5,  n=20, N=5
#   - medium : m=5,  n=50, N=10
#   - large  : m=5,  n=50, N=20
# =============================================================================

CONFIGS = [
    # (suffix,   m,  n,   N_scenarios)
    ("small",    5,  20,  5),
    ("medium",   5,  50,  10),
    ("large",    5,  50,  20),
]

SPLITS = [
    # (split_name, nb_episodes, seed_offset)
    ("train", 200, 0),
    ("val",    30, 1),
    ("test",   50, 2),
]

SEED_BASE = 42

if __name__ == "__main__":

    print("=== Génération des datasets CCSP ===\n")

    for split_name, nb_episodes, seed_offset in SPLITS:
        print(f"--- {split_name.upper()} ---")
        for suffix, m, n, N in CONFIGS:
            generate_dataset(
                filepath=f"data/covset/datasets/{split_name}/ccsp-{split_name}-{suffix}.txt",
                nb_episodes=nb_episodes,
                nb_scenarios=N,
                nb_constraints=m,
                nb_items=n,
                pA_range=(0.2, 0.5),
                pB_range=(0.3, 0.7),
                seed=SEED_BASE + seed_offset
            )
        print()

    print("=== Terminé ===")
    print("\nFormat de chaque ligne :")
    print("  [episode, scenario, nb_constraints, nb_items, pA, pB,")
    print("   A_00, A_01, ..., A_{m-1,n-1},  (m*n valeurs)")
    print("   b_0,  b_1,  ..., b_{m-1}]      (m valeurs)")